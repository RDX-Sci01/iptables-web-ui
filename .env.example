# Security-hardened environment configuration
# Copy this file to .env and fill in with your own values
# Make sure to secure .env file permissions: chmod 600 .env

# Set a strong, random password for the web UI
# Generate a strong password: openssl rand -base64 32
WEBUI_PASSWORD=your_strong_password_here

# Optional: Set JWT secret for token generation
# Leave empty to auto-generate (tokens will be invalidated on restart)
# Generate a secret: openssl rand -hex 48
JWT_SECRET=

# HTTPS configuration (for production use)
# Set to 'true' to enable secure cookie flags for HTTPS
HTTPS=false

# Data directory path
DATA_DIR=/app/data

# Server configuration
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8585

# Iptables configuration
IPTABLES_PATH=/sbin/iptables
IP6TABLES_PATH=/sbin/ip6tables
CONNTRACK_PATH=/usr/sbin/conntrack

# Firewall rules location
IPTABLES_RULES_PATH=/etc/iptables/rules.v4
IP6TABLES_RULES_PATH=/etc/iptables/rules.v6

# Flush rules on restore (dangerous - set to false by default)
FLUSH_ON_RESTORE=false
